# Copiar a .env y completar con valores reales. *.env NO se commitea.

# ── Postgres (servicio db del compose) ────────────────────────────────────────
POSTGRES_USER=usuario
POSTGRES_PASSWORD=cambiar-me
POSTGRES_DB=sos_facturacion

# ── App ───────────────────────────────────────────────────────────────────────
# En Docker/compose DATABASE_URL se arma sola desde las vars de arriba
# (host del servicio = db). Solo hace falta setearla para correr sin Docker:
# DATABASE_URL=postgresql://usuario:password@localhost:5432/sos_facturacion

# Imagen a publicar/levantar
IMAGE=fecca81/sos-facturacion

# Puerto del host donde se expone la app
APP_PORT=8083

# Segundos máximos para construir una página (queries pesadas con histórico)
RESPONSE_TIMEOUT=30

# Usuario admin creado al arrancar si no existe (idempotente).
ADMIN_NOMBRE=admin
ADMIN_PASSWORD=cambiar-me

# Clave para firmar sesiones de NiceGUI (app.storage.user). Requerida.
# Generar una con: python -c "import secrets; print(secrets.token_urlsafe(32))"
STORAGE_SECRET=cambiar-me
